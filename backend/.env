DB_HOST=localhost
DB_PORT=5432
DB_NAME=route_card
DB_USER=route_card
DB_PASSWORD=route_card

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=oarc-extractions
MINIO_SECURE=false
# MinIO disabled — files go to LOCAL_UPLOAD_ROOT (or backend/uploads/route-card by default)
# Example outside backend: LOCAL_UPLOAD_ROOT=D:/RouteCardData/uploads
LOCAL_UPLOAD_ROOT=D:/PMF/route-card-app/uploads
# Later: STORAGE_BACKEND=auto  (or minio) when Docker MinIO is up
STORAGE_BACKEND=local
MINIO_CONNECT_TIMEOUT_SEC=2
MINIO_READ_TIMEOUT_SEC=10
MINIO_DOWN_CACHE_SEC=60

ODA_CONVERTER_PATH=

OCR_ENABLED=true
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_DPI=250
OCR_MAX_PAGES=12

# Drawing mind: cpu_spatial (default) | local_vlm (requires Ollama + vision model running)
DRAWING_MIND_ENGINE=local_vlm
# Use cpu_spatial if local_vlm / Ollama is not available
DRAWING_MIND_SPATIAL_DPI=200
DRAWING_MIND_MAX_PAGES=12
# Ollama must be running (`ollama serve`) with the vision model created, e.g. qwen3.8-27b-vl
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VLM_MODEL=qwen3.8-27b-vl:latest
# 27B vision can be slow on first load + multi-page; keep high
OLLAMA_TIMEOUT_SEC=900
OLLAMA_VLM_DPI=160
OLLAMA_VLM_MAX_PAGES=6
OLLAMA_VLM_MAX_IMAGE_EDGE=1600

SECRET_KEY=^oPlEbU&3%WturKey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ENABLED=true

# Optional: POST JSON on each in-app notification
NOTIFY_WEBHOOK_URL=
