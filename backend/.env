DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=route_card
DB_USER=route_card
DB_PASSWORD=route_card

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=oarc-extractions
MINIO_SECURE=false
# MinIO disabled — files go to LOCAL_UPLOAD_ROOT (or backend/uploads/route-card by default)
# Example outside backend: LOCAL_UPLOAD_ROOT=D:/RouteCardData/uploads
LOCAL_UPLOAD_ROOT=D:/PMF/route-card-app/uploads
# Later: STORAGE_BACKEND=auto  (or minio) when Docker MinIO is up
STORAGE_BACKEND=local
MINIO_CONNECT_TIMEOUT_SEC=2
MINIO_READ_TIMEOUT_SEC=10
MINIO_DOWN_CACHE_SEC=60

ODA_CONVERTER_PATH=

OCR_ENABLED=true
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_DPI=250
OCR_MAX_PAGES=12

# Drawing mind: cpu_spatial | local_vlm (on-prem vLLM, OpenAI-compatible /v1)
DRAWING_MIND_ENGINE=local_vlm
DRAWING_MIND_SPATIAL_DPI=200
DRAWING_MIND_MAX_PAGES=12
# Local vLLM (OpenAI-compatible) — model id from GET /v1/models (max_model_len 8192)
OLLAMA_BASE_URL=http://172.195.132.152:8010
OLLAMA_VLM_MODEL=google/gemma-4-E4B-it
OLLAMA_VLM_MAX_TOKENS=2048
OLLAMA_TIMEOUT_SEC=1800
OLLAMA_VLM_DPI=160
OLLAMA_VLM_MAX_PAGES=6
OLLAMA_VLM_MAX_IMAGE_EDGE=1600
OLLAMA_VLM_NOTE_DPI=360
OLLAMA_VLM_NOTE_MAX_EDGE=2800

SECRET_KEY=^oPlEbU&3%WturKey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
AUTH_ENABLED=true

# Optional: POST JSON on each in-app notification
NOTIFY_WEBHOOK_URL=

FILE_ENCRYPTION_KEY=kcBp8BxOmmzlpblbSljiTPklgNW+MvJhmLisbHCBC/I=

# SAP Zppfm001 org / work-centre sync (intranet SOAP — credentials never in source)
SAP_USERNAME=BSTCUSR
SAP_PASSWORD=Bstc@1234
SAP_VERIFY_SSL=true
SAP_TRUST_ENV=true
